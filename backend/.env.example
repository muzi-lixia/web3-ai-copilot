# 复制为 .env 后按需修改。所有字段都有默认值，不填也能跑 V1。

# ── 应用 ────────────────────────────────────────────────
ENVIRONMENT=development
# 生产必须 ENVIRONMENT=production 且 DEBUG=false，密钥和签名域名会在启动时校验。
DEBUG=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── 链 ──────────────────────────────────────────────────
# 链本身的参数（chain_id / 原生币 / Multicall / 公共节点 / 浏览器）
# 在 app/config/constants/chains.py 里，不在这里。这里只有「选哪条」和「覆盖节点」。
DEFAULT_CHAIN_ID=80094

# 覆盖链注册表的公共节点，格式：chain_id=url|url,chain_id=url
# 需要更稳或带 key 的专属节点（Alchemy / Infura）时填这里 ——
# 不要把带 key 的 URL 写进 chains.py，那个文件是要提交到仓库的。
# RPC_OVERRIDES=80094=https://berachain-mainnet.g.alchemy.com/v2/xxx

# ── 行情 ────────────────────────────────────────────────
# 两个源互补，都不需要注册和 key：
#   DexScreener  价格 / 24h 涨跌 / 市值 / 24h 成交量，主源
#   DefiLlama    只有价格，但收录了没有 DEX 池子的币（如 BGT），补位
# 要换源改 app/services/market_service.py；这里只调地址、超时与缓存。
DEXSCREENER_BASE_URL=https://api.dexscreener.com
DEFILLAMA_BASE_URL=https://coins.llama.fi
MARKET_TIMEOUT_SECONDS=10
MARKET_CACHE_TTL=60
# 缓存过期后最多再使用 300 秒；报价自身时间也受 TTL + 此值约束。
MARKET_MAX_STALE_SECONDS=300
# 行情请求专用代理。留空 = 跟随环境变量 HTTP_PROXY / HTTPS_PROXY。
# 若行情取不到价（表现为连不上行情源），多半是环境代理对该域名不工作，
# 在这里显式指定可绕开。示例：http://127.0.0.1:7890
MARKET_PROXY=

# ── 质押 ────────────────────────────────────────────────
# 质押的年化与收益只有 Berachain 自己算得出来（它是 PoL 激励回购成 WBERA 注入金库
# 形成的），DexScreener / DefiLlama 都给不出。Beep 就是 BeraHub 前端调的那个数据层
# （Berachain Event Extraction Pipeline），所以这里的数就是页面上的那个数。
# 金库地址、份额符号、解绑时长在 app/config/constants/staking.py 里，不在这里。
BEEP_BASE_URL=https://beep.berachain.com
# Beep 要求的调用方标识（X-Client-Id）。不注册、不缺校验，但要稳定唯一 ——
# 缺了会被直接拒（400）。用它自己的产品名即可。
BEEP_CLIENT_ID=web3aicopilot.api
BEEP_TIMEOUT_SECONDS=10
# 年化缓存秒数。金库收益按批注入（初期每周 2~3 次），秒级刷新拿到的还是同一个数。
BEEP_CACHE_TTL=300

# ── 钱包登录（nonce → 签名 → JWT）────────────────────────
# 生产必须设置，否则任何人都能伪造登录凭证。生成方式：
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# 不设置则用开发默认值；生产必须设置至少 32 字节的独立随机密钥。
# JWT_SECRET=
JWT_EXPIRE_MINUTES=10080
NONCE_TTL_SECONDS=300
NONCE_MAX_ENTRIES=10000
# nonce / verify 共用每个客户端 IP 的每分钟额度。当前只支持单 worker。
AUTH_RATE_PER_MINUTE=30
AUTH_RATE_MAX_ENTRIES=10000
# 写进签名消息的域名，用户会在钱包里看到「正在向谁授权」
SIWE_DOMAIN=localhost:5173

# ── 模型出口（见 app/llm/client.py）──────────────────────
# 四家（DeepSeek / 通义千问 / 本地 Ollama / OpenAI）都提供 OpenAI 兼容的
# /chat/completions，换平台只改 MODEL_PROVIDER。
#
# 默认选本地 Ollama：唯一不需要 key、不出网的选项。
MODEL_PROVIDER=ollama

# 模型名。留空 = 用该平台的内置默认：
#   ollama   qwen2.5:7b        deepseek  deepseek-chat
#   qwen     qwen-plus         openai    gpt-4o-mini
# 本地这一项要填对（用 `ollama list` 看有哪些）。名字拼错不会报错，只会得到空回复。
MODEL_NAME=

# 各平台的 key。变量名用各家的官方叫法 —— 通义的是 DASHSCOPE_API_KEY，
# 不是 QWEN_API_KEY。用哪家填哪家，其余留空。
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
OPENAI_API_KEY=

# 覆盖平台的默认地址（变量名前缀 = 平台名大写）。用途：自建网关、反向代理、
# 把 Ollama 指向局域网另一台机器。
DEEPSEEK_BASE_URL=
QWEN_BASE_URL=
OPENAI_BASE_URL=
OLLAMA_BASE_URL=

# 请求超时。留空 = 60 秒，比行情那 10 秒宽得多：本地小模型冷启动要加载权重。
# 其余参数（temperature / max_tokens …）在 get_client() 时透传。
MODEL_TIMEOUT_SECONDS=60

# 配完先实打一次（客户端会受本机代理配置影响）：
#   .venv/bin/python scripts/check_model.py
