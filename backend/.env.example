# 复制为 .env 后按需修改。所有字段都有默认值，不填也能跑 V1。

# ── 应用 ────────────────────────────────────────────────
DEBUG=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── 链 ──────────────────────────────────────────────────
# 公共节点起步，免注册。量大或需要更稳时换 Alchemy / Infura 专属 URL。
ETH_RPC_URL=https://eth.llamarpc.com
ETH_RPC_FALLBACK_URLS=https://rpc.ankr.com/eth,https://cloudflare-eth.com
CHAIN_ID=1

# ── 行情 ────────────────────────────────────────────────
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
# 免费版不需要；注册 Demo key 后填这里可提高限流额度
COINGECKO_API_KEY=
MARKET_CACHE_TTL=60

# ── LLM（Phase C 启用）──────────────────────────────────
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# ── 自有锁仓合约（Phase D 部署 Sepolia 后填）─────────────
STAKING_CONTRACT_ADDRESS=
