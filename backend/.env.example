# 两个服务（8000 / 8001）共用这一份配置，凭据不提交仓库（见 .gitignore）。
# 本文件是模板：复制成 .env 后按需修改，没写的项用 app/core/config.py 里的默认值。
# 配置在进程启动时读入并缓存，改完要重启服务；生产必须修改开发口令与签名域。
# ── 应用与运行环境 ──
# 运行环境标识。填 production 会开启启动校验：独立凭据、DEBUG、签名域、跨域来源缺一不可。
ENVIRONMENT=development
# 调试模式。生产环境必须为 false，否则启动被拒。
DEBUG=true
# 接口路径前缀，两个服务共用。
API_PREFIX=/api/v1
# 允许跨域的前端来源，逗号分隔；不列出来的来源会被浏览器拦掉。
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# ── 数据库凭据 ──
# 运行账号：只有业务表读写权，没有建表权，日常运行用它。
DATABASE_URL=postgresql+asyncpg://app_rw:copilot_dev_rw@127.0.0.1:54329/web3copilot
# 迁移账号：负责建表、改表（DDL），只在执行数据库迁移时使用。
DATABASE_MIGRATION_URL=postgresql+asyncpg://app_ddl:copilot_dev_ddl@127.0.0.1:54329/web3copilot
# 基础服务(8000)自己的连库账号，与运行账号分开。
FOUNDATION_DATABASE_URL=postgresql+asyncpg://app_foundation:copilot_dev_foundation@127.0.0.1:54329/web3copilot
# agent 服务(8001)自己的连库账号；行级安全限制它读不到地址、登录凭据与真实资产表。
AGENT_DATABASE_URL=postgresql+asyncpg://app_agent:copilot_dev_agent@127.0.0.1:54329/web3copilot
# agent(8001) 调用基础服务(8000)的入口地址。
FOUNDATION_URL=http://127.0.0.1:8000
# ── 认证与会话（SIWE：nonce → 钱包签名 → JWT）──
# JWT 签名密钥：上线必须换成随机值，否则 token 可被伪造；HS256 要求不短于 32 字节。
# 生成：python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-insecure-secret-change-me-before-deploy
# 写入签名消息的域名，让用户在钱包里看到「我在向谁授权」；生产必须换真实域名。
SIWE_DOMAIN=localhost:5173
# 签名消息里的完整来源 URL。
SIWE_URI=http://localhost:5173
# 访问令牌寿命（分钟）。
ACCESS_TOKEN_MINUTES=15
# 登录会话寿命（天）：刷新令牌的最长有效期，也是「登出即失效」的判定依据。
LOGIN_SESSION_DAYS=7
# 登录用 nonce 的有效期（秒）；签名是一次性动作，过期即作废。
NONCE_TTL_SECONDS=300
# ── 限流与会话保留 ──
# 登录接口每 IP 每分钟的调用上限。
AUTH_RATE_PER_MINUTE=30
# 已登录用户每分钟的请求上限。
REQUEST_LIMIT_PER_MINUTE=60
# 匿名用户每分钟的请求上限，比已登录用户更严。
ANONYMOUS_LIMIT_PER_MINUTE=20
# 会话保留时长（小时），720 即 30 天。
CONVERSATION_TTL_HOURS=720
# ── 链与行情 ──
# 保留既有 Berachain 基础业务，另外登记 Ethereum/BSC/Polygon/Arbitrum/Base。
# 请求不带 chain_id 时默认查哪条链；80094 = Berachain，可选项见 blockchain/chains.py。
DEFAULT_CHAIN_ID=80094
# 覆盖链注册表里的公共 RPC，形如 80094=https://a|https://b,1=https://c；留空用公共节点。
# 带 key 的私有节点只能写在这里 —— chains.py 要提交仓库，key 写进去等于泄漏。
RPC_OVERRIDES=
# 行情专用代理（示例 http://127.0.0.1:7890）；留空则跟随 HTTP_PROXY / HTTPS_PROXY。
MARKET_PROXY=
# 单次行情请求超时（秒）。
MARKET_TIMEOUT_SECONDS=10
# 行情缓存的新鲜期（秒）：免费源有限流，行情也不需要秒级新鲜度。
MARKET_CACHE_TTL=60
# 上游全部失败后允许多旧的价格顶上（秒），这类回退数据会标记为过期。
MARKET_MAX_STALE_SECONDS=300
# 行情缓存的条目上限，超出即淘汰，防止长时间运行后内存增长。
CACHE_MAX_ENTRIES=256
# ── 模型与预算 ──
# Agent 每轮固定配置快照，切换不会改变已经执行的轮次；不自动切云端。
# 模型提供方：ollama（本地）/ deepseek / qwen（云端）。
MODEL_PROVIDER=ollama
# 模型名：本地是 Ollama 里的 tag，云端要写实际模型 id。
MODEL_NAME=qwen2.5:7b
# 服务地址；留空用内置端点（Ollama 本机 11434 / deepseek / dashscope）。
MODEL_BASE_URL=http://127.0.0.1:11434
# 上下文窗口；云端必须按实际模型填，留空会被拒绝使用该模型。
MODEL_CONTEXT_WINDOW=16384
# 单次回复的输出上限，含推理模型的思考 token；给太小正文会被截断。
MODEL_OUTPUT_TOKENS=1024
# 上下文预算里预留给本轮新增内容的余量（token）。
MODEL_CONTEXT_RESERVE=1024
# 每次模型调用前允许进入上下文的历史预算（估算 token），超出后从最旧整轮开始删。
AGENT_CONTEXT_TOKENS=8192
# 同时进行的模型调用数：本地默认串行，云端可按部署容量增加。
MODEL_CONCURRENCY=1
# 一轮回答里模型最多被调用几次（含工具往返）；给太小会在写正文前被拦下。
AGENT_MODEL_CALL_LIMIT=3
# 一轮回答里工具最多被调用几次。
AGENT_TOOL_CALL_LIMIT=5
# 同时排队的提问数上限，超出直接拒绝。
CHAT_QUEUE_LIMIT=16
# 排队等待模型额度的超时（秒）。
CHAT_QUEUE_TIMEOUT_SECONDS=30
# 一整轮回答的总超时（秒），从受理开始算。
COPILOT_TIMEOUT_SECONDS=180
# 流式正文的落库节拍（秒）；结束、失败、取消时会额外立即保存一次。
COPILOT_SNAPSHOT_SECONDS=1
# 单个工具执行的超时（秒）。
TOOL_TIMEOUT_SECONDS=30
# 云端模型专用代理，留空直连；不读 HTTP_PROXY / HTTPS_PROXY，避免环境代理时灵时不灵。
MODEL_PROXY=
# 当前提供方的 API key（ollama 不需要）。
MODEL_API_KEY=
# DeepSeek 的凭据与参数：仅当改写模型切到 deepseek（REWRITE_PROVIDER）时生效。
DEEPSEEK_API_KEY=
# 切换后使用的模型名。
DEEPSEEK_MODEL=deepseek-chat
# 切换后使用的上下文窗口。
DEEPSEEK_CONTEXT_WINDOW=65536
# 通义千问的凭据与参数，用途同上。
QWEN_API_KEY=
# 切换后使用的模型名。
QWEN_MODEL=qwen-plus
# 切换后使用的上下文窗口。
QWEN_CONTEXT_WINDOW=32768
# ── 追踪 ──
# 一次提问的完整链路（每步模型调用、工具调用、耗时、用量）上报到 LangSmith。
# 留空 key 即不启用，本地与测试不产生外发。
LANGSMITH_API_KEY=
# 上报到 LangSmith 的项目名。
LANGSMITH_PROJECT=web3-ai-copilot
# ── 知识库 ──
# 知识库：只有白名单里的钱包地址能上传文档，逗号分隔；留空即无人可传。
ADMIN_ADDRESSES=
# 上传原件的落盘目录，相对后端工作目录；库里只存元数据。
KNOWLEDGE_STORAGE_DIR=var/knowledge
# 单个上传文件的体积上限（字节），默认 20 MiB，超出直接拒绝。
KNOWLEDGE_MAX_BYTES=20971520
# 向量服务的地址，默认本机 Ollama；走本机地址，不受环境代理影响。
EMBEDDING_BASE_URL=http://127.0.0.1:11434
# 生成检索向量的本地模型；换模型必须同步改下面的维度并重建 chunks.embedding 列。
EMBEDDING_MODEL=bge-m3:latest
# 向量列维度；改这个值必须同时重建 chunks.embedding 列，否则写入会被拒绝。
KNOWLEDGE_EMBEDDING_DIMENSIONS=1024
