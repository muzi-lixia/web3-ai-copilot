# 此文件为配置样例；复制为对应 .env.*.local 后显式加载，或由部署环境注入。
# 示例数据库口令仅供本地开发，生产必须替换；未列出的可选配置沿用代码默认值。

# 运行环境：development、test 或 production；生产环境启用严格配置校验。
ENVIRONMENT=development

# 文档 worker 专用数据库连接，使用 app_knowledge 最小权限角色。
KNOWLEDGE_DATABASE_URL=postgresql+asyncpg://app_knowledge:copilot_dev_knowledge@127.0.0.1:54329/web3copilot

# 原件存储目录；基础服务与 worker 必须共享同一目录，生产建议绝对路径。
KNOWLEDGE_STORAGE_DIR=var/knowledge

# 向量化服务默认地址；在线检索和离线入库均可单独覆盖。
EMBEDDING_BASE_URL=http://127.0.0.1:11434

# 向量模型标识；必须与另一运行单元一致。
EMBEDDING_MODEL=bge-m3:latest

# 向量模型修订版本；更新模型时递增，并重新入库旧文档。
EMBEDDING_REVISION=1

# 向量维度；须匹配模型及数据库向量列，变更需数据库迁移。
KNOWLEDGE_EMBEDDING_DIMENSIONS=1024
