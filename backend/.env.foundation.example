# 此文件为配置样例；复制为对应 .env.*.local 后显式加载，或由部署环境注入。
# 示例数据库口令仅供本地开发，生产必须替换；未列出的可选配置沿用代码默认值。

# 运行环境：development、test 或 production；生产环境启用严格配置校验。
ENVIRONMENT=development

# 调试模式；生产必须设为 false。
DEBUG=true

# 基础服务数据库连接，使用 app_foundation 角色；生产替换示例口令。
FOUNDATION_DATABASE_URL=postgresql+asyncpg://app_foundation:copilot_dev_foundation@127.0.0.1:54329/web3copilot

# 登录和委托凭证签名密钥；生产使用至少 32 字节随机值，仅基础服务持有。
JWT_SECRET=dev-only-insecure-secret-change-me-before-deploy

# 钱包签名绑定的站点域名，包含端口，不包含协议。
SIWE_DOMAIN=localhost:5173

# 钱包签名绑定的完整站点地址，包含协议。
SIWE_URI=http://localhost:5173

# 允许跨域访问的前端来源，多个地址用英文逗号分隔。
CORS_ORIGINS=http://localhost:5173

# 原件存储目录；基础服务与 worker 必须共享同一目录，生产建议绝对路径。
KNOWLEDGE_STORAGE_DIR=var/knowledge

# 向量化服务默认地址；在线检索和离线入库均可单独覆盖。
EMBEDDING_BASE_URL=http://127.0.0.1:11434

# 向量模型标识；必须与另一运行单元一致。
EMBEDDING_MODEL=bge-m3:latest

# 向量模型修订版本；更新模型时递增，并重新入库旧文档。
EMBEDDING_REVISION=1

# 向量维度；须匹配模型及数据库向量列，变更需数据库迁移。
KNOWLEDGE_EMBEDDING_DIMENSIONS=1024

# 知识库管理权限钱包白名单，多个地址用英文逗号分隔。
ADMIN_ADDRESSES=
