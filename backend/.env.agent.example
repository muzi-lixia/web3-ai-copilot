# 此文件为配置样例；复制为对应 .env.*.local 后显式加载，或由部署环境注入。
# 示例数据库口令仅供本地开发，生产必须替换；未列出的可选配置沿用代码默认值。

# 运行环境：development、test 或 production；生产环境启用严格配置校验。
ENVIRONMENT=development

# 调试模式；生产必须设为 false。
DEBUG=true

# Agent 数据库连接，使用 app_agent 角色；生产替换示例口令。
AGENT_DATABASE_URL=postgresql+asyncpg://app_agent:copilot_dev_agent@127.0.0.1:54329/web3copilot

# Agent 访问基础 HTTP 服务的内部地址。
FOUNDATION_URL=http://127.0.0.1:8000

# 允许跨域访问的前端来源，多个地址用英文逗号分隔。
CORS_ORIGINS=http://localhost:5173

# 主模型提供方：ollama、deepseek 或 qwen。
MODEL_PROVIDER=ollama

# 本地 Ollama 模型服务地址；留空使用提供方默认地址。
OLLAMA_BASE_URL=http://127.0.0.1:11434

# DeepSeek API 密钥；使用该提供方时配置，禁止提交真实密钥。
DEEPSEEK_API_KEY=

# 通义千问 API 密钥；使用该提供方时配置，禁止提交真实密钥。
QWEN_API_KEY=

# 本地 Ollama 模型名称；模型名称、地址、窗口均按提供方分别配置。
OLLAMA_MODEL=qwen2.5:7b

# Agent 终态补写持久目录；生产挂载独立持久卷，仅运行用户可访问，不与知识库共享。
AGENT_OUTBOX_DIR=var/agent-outbox

# 调试时记录脱敏后的提示词、工具输入输出与回答；默认 false 仅记录运行元信息。
LANGSMITH_CAPTURE_CONTENT=false
