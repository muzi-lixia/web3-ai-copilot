# 复制为 .env 后填写。.env 已被 .gitignore 忽略，不会进版本库。

# Reown projectId —— 钱包连接弹窗（Reown AppKit）的必需项。
# 它是**客户端公开标识，不是密钥**，但仍按环境配置处理，便于换项目/换环境。
# 免费创建：https://cloud.reown.com
VITE_REOWN_PROJECT_ID=

# 后端地址。开发期留空即可：vite.config.ts 的 proxy 会把 /api 转发到 127.0.0.1:8000。
# 前端单独部署（后端在别的域名）时才需要填。
# VITE_API_BASE_URL=https://your-backend.example.com/api/v1

# 独立 Agent 服务地址；开发期留空，通过 Vite 转发至 8001。
# VITE_AGENT_BASE_URL=https://agent.example.com/api/v1
# 部署时配置两个服务的健康探针 URL，或在反向代理中提供同名路径。
# VITE_FOUNDATION_HEALTH_URL=https://foundation.example.com/health
# VITE_AGENT_HEALTH_URL=https://agent.example.com/health

# 两个服务的原始 OpenAPI 文档；开发期使用上述 Vite 代理。
# VITE_FOUNDATION_OPENAPI_URL=https://foundation.example.com/openapi.json
# VITE_AGENT_OPENAPI_URL=https://agent.example.com/openapi.json
